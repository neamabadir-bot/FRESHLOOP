# Copy to .env (or set these in your hosting provider). All are optional for local development.

# Secret used to sign login tokens. Set a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string

# Port of the API server (the Vite dev server proxies /api to it).
PORT=3001

# Where the SQLite database file is stored (default: data/freshloop.db).
# DB_FILE=data/freshloop.db
