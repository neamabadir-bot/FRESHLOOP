{
  "name": "freshloop",
  "version": "0.1.0",
  "private": true,
  "description": "FRESHLOOP – smart food inventory app that helps students reduce household food waste (MVP).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js --port=3001",
    "dev:client": "vite --host",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "supertest": "^7.0.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
